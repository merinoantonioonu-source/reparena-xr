<!--
  Los logros importantes, en grande y dorados (RepArena, src/60_ui.js: trophy): un récord, el récord al fallo, el cofre
  abierto…, aparte del marcador, uno tras otro, unos 3,6 s cada uno, arriba, por encima de lo que llega. 1,25 m de ancho
  (medidas en centímetros); el título, el texto y el color los pone el juego.
-->
<style>
  .root {
    flex-direction: row;
    align-items: center;
    gap: 4;
    width: 125;
    padding-top: 4;
    padding-bottom: 4;
    padding-left: 6;
    padding-right: 6;
    background-color: #2c1c08;
    border-radius: 6;
    border-width: 1.2;
    border-color: #ffd166;
  }
  .star {
    width: 6;
    height: 6;
    border-radius: 3;
    background-color: #ffd166;
  }
  .body {
    flex-direction: column;
    align-items: center;
    gap: 1.6;
    flex-grow: 1;
  }
  .title {
    font-size: 9;
    color: #ffd166;
    text-align: center;
  }
  .sub {
    font-size: 4;
    color: #fff3d6;
    text-align: center;
  }
</style>
<div id="box" class="root">
  <div id="s1" class="star"></div>
  <div class="body">
    <span id="title" class="title display">¡NUEVO RÉCORD!</span>
    <span id="sub" class="sub">Nunca habías llegado tan lejos</span>
  </div>
  <div id="s2" class="star"></div>
</div>
