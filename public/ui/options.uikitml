<!--
  Opciones (RepArena, src/70_game.js: optionsMenu y settingsRows): todo lo que no está en el menú principal, en pestañas
  con su color (Rivales y armas, Progreso, Sonido, Entorno y Ajustes); en Ajustes, una pestaña por grupo del esquema. Cada
  ajuste en una fila: su nombre, − y + (o sus opciones en teclas) y la tecla «?» con su explicación al lado del menú.
  Salen del esquema de ajustes (src/core/schema.ts); las filas (o1-o9) y las pestañas (s0-s9) las llena el juego
  (src/ui/menu.ts), de nueve en nueve con ◂ ▸ si no caben. Medidas en centímetros (90 cm de ancho).
-->
<style>
  .root {
    anchor-y: top;
    flex-direction: column;
    align-items: center;
    width: 90;
    padding-top: 2.4;
    padding-bottom: 2.4;
    padding-left: 4;
    padding-right: 4;
    gap: 1.1;
    background-color: #12151d;
    border-radius: 4;
    border-width: 0.4;
    border-color: #ffd166;
  }
  .title {
    font-size: 5;
    color: #ffd166;
  }
  .tabs {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8;
    width: 82;
  }
  .tab {
    height: 5.6;
    padding-left: 2;
    padding-right: 2;
    justify-content: center;
    align-items: center;
    border-radius: 1.6;
    background-color: #2a2f3a;
    border-width: 0.3;
    border-color: #2a2f3a;
    cursor: pointer;
  }
  .tabt {
    font-size: 2.3;
    color: #e9eef7;
  }
  .body {
    flex-direction: column;
    align-items: center;
    gap: 1.1;
    width: 82;
    padding-top: 1.2;
    padding-bottom: 1.2;
    background-color: #171b26;
    border-radius: 2.4;
  }
  .pager {
    flex-direction: row;
    align-items: center;
    gap: 1.2;
  }
  .back {
    width: 40;
    height: 6.4;
    justify-content: center;
    align-items: center;
    border-radius: 2;
    background-color: #3cf0c6;
    cursor: pointer;
  }
  .back:hover {
    background-color: #8bffe6;
  }
  .backt {
    font-size: 2.6;
    color: #0d1016;
  }
  .k {
    height: 4.4;
    padding-left: 1.3;
    padding-right: 1.3;
    justify-content: center;
    align-items: center;
    border-radius: 1.6;
    background-color: #2a2f3a;
    cursor: pointer;
  }
  .k:hover {
    background-color: #3b4252;
  }
  .kt {
    font-size: 2;
    color: #e9eef7;
  }
  .frow {
    flex-direction: row;
    align-items: center;
    gap: 1;
    width: 82;
  }
  .flab {
    width: 22;
    font-size: 2;
    color: #c9d2e3;
  }
  .fctl {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8;
    width: 53;
  }
  .step {
    width: 4.4;
    height: 4.4;
    justify-content: center;
    align-items: center;
    border-radius: 1.6;
    background-color: #3a4152;
    cursor: pointer;
  }
  .step:hover {
    background-color: #4c5569;
  }
  .stept {
    font-size: 3.2;
    color: #ffffff;
  }
  .fval {
    width: 16;
    font-size: 2.2;
    color: #ffffff;
    text-align: center;
  }
  .help {
    width: 4.4;
    height: 4.4;
    justify-content: center;
    align-items: center;
    border-radius: 2.2;
    background-color: #2a2f3a;
    border-width: 0.3;
    border-color: #a49fc8;
    cursor: pointer;
  }
  .help:hover {
    background-color: #3b4252;
  }
  .helpt {
    font-size: 2.6;
    color: #a49fc8;
  }
  .note {
    font-size: 2;
    color: #a49fc8;
    text-align: center;
    width: 82;
  }
  .display {
    letter-spacing: 0.1;
  }
</style>
