<!--
  El resumen de la ronda (RepArena, opción A elegida por el usuario: endMenu y summaryDraw): el título grande (¡VICTORIA!,
  DERROTA o RESUMEN), dónde acabó y el ejercicio; el número grande (repeticiones) con la medalla y las perfectas; tres
  casillas (puntos, tiempo y kcal); un solo logro, el más importante; y dos botones, «Otra ronda» y «Menú principal».
  Cuelga de su borde de arriba, como los menús. 70 cm de ancho; los textos y colores los pone el juego (src/ui/menu.ts).
-->
<style>
  .root {
    anchor-y: top;
    flex-direction: column;
    align-items: center;
    width: 70;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 3;
    padding-right: 3;
    gap: 1.4;
    background-color: #3a2d5c;
    border-radius: 3;
    border-width: 0.8;
    border-color: #140c1a;
  }
  .title {
    font-size: 7;
    color: #ffd166;
  }
  .where {
    font-size: 2.4;
    color: #eeeaff;
    text-align: center;
  }
  .card {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 4;
    width: 62;
    padding-top: 2;
    padding-bottom: 2;
    border-radius: 2.4;
    background-color: #241c33;
  }
  .big {
    font-size: 11;
    color: #ffffff;
  }
  .unit {
    font-size: 2.4;
    color: #a49fc8;
  }
  .col {
    flex-direction: column;
    align-items: center;
    gap: 0.8;
  }
  .medal {
    width: 8;
    height: 8;
    border-radius: 4;
    border-width: 0.6;
    border-color: #140c1a;
    background-color: #c9874a;
  }
  .medal-t {
    font-size: 2;
    color: #eeeaff;
  }
  .pct {
    font-size: 3.4;
    color: #3cf0c6;
  }
  .tiles {
    flex-direction: row;
    gap: 1.6;
  }
  .tile {
    flex-direction: column;
    align-items: center;
    width: 19.5;
    padding-top: 1.2;
    padding-bottom: 1.2;
    border-radius: 2;
    background-color: #241c33;
  }
  .tv {
    font-size: 3.6;
    color: #ffd166;
  }
  .tl {
    font-size: 1.9;
    color: #a49fc8;
  }
  .chip {
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 2.4;
    padding-right: 2.4;
    border-radius: 2;
    border-width: 0.4;
    border-color: #ffd166;
  }
  .chip-t {
    font-size: 2.4;
    color: #ffd166;
  }
  .btns {
    flex-direction: row;
    gap: 2;
  }
  .btn {
    width: 30;
    height: 8;
    justify-content: center;
    align-items: center;
    border-radius: 4;
    background-color: #3cf0c6;
    cursor: pointer;
  }
  .btn:hover {
    background-color: #8bffe6;
  }
  .btn2 {
    background-color: #2a2f3a;
  }
  .btn2:hover {
    background-color: #3a4150;
  }
  .bt {
    font-size: 3.2;
    color: #0d1016;
  }
  .bt2 {
    color: #e9eef7;
  }
</style>
<div class="root">
  <span id="s-title" class="title display">DERROTA</span>
  <span id="s-where" class="where">Oleada 3 de 5 · Sentadillas</span>
  <div class="card">
    <div class="col">
      <span id="s-big" class="big display">42</span>
      <span id="s-unit" class="unit">repeticiones</span>
    </div>
    <div class="col">
      <div id="s-medal" class="medal"></div>
      <span id="s-medalt" class="medal-t">Bronce</span>
    </div>
    <div class="col">
      <span id="s-pct" class="pct display">60 %</span>
      <span class="unit">perfectas</span>
    </div>
  </div>
  <div class="tiles">
    <div class="tile"><span id="s-t0" class="tv display">1234</span><span class="tl">puntos</span></div>
    <div class="tile"><span id="s-t1" class="tv display">3:12</span><span class="tl">tiempo</span></div>
    <div class="tile"><span id="s-t2" class="tv display">25</span><span class="tl">kcal (aprox.)</span></div>
  </div>
  <div id="s-chip" class="chip"><span id="s-chipt" class="chip-t">¡Nuevo récord!</span></div>
  <div class="btns">
    <button id="s-again" class="btn"><span class="bt display">OTRA RONDA</span></button>
    <button id="s-menu" class="btn btn2"><span class="bt bt2 display">MENÚ PRINCIPAL</span></button>
  </div>
</div>
