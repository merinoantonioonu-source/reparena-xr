<!--
  La columna «HOY», a la izquierda del menú principal (RepArena, src/73_career.js: drawHoy): las tres metas de hoy con lo
  que llevas, el cofre, la racha con sus escudos y tu nivel con su barra. 36 cm de ancho (medidas en centímetros);
  cuelga de su borde de arriba como el menú. Lo llena el menú (src/ui/menu.ts); al tocarla, Progreso → Misiones.
-->
<style>
  .root {
    anchor-y: top;
    flex-direction: column;
    width: 36;
    padding-top: 2;
    padding-bottom: 2.4;
    padding-left: 2.4;
    padding-right: 2.4;
    gap: 1.4;
    background-color: #1a1430;
    border-radius: 4;
    border-width: 0.5;
    border-color: #3cf0c6;
  }
  .title {
    font-size: 3.6;
    color: #ffd166;
    text-align: center;
  }
  .goal {
    flex-direction: row;
    align-items: center;
    gap: 1.2;
    width: 31;
    height: 5.6;
  }
  .dot {
    width: 3.6;
    height: 3.6;
    border-radius: 1.8;
    justify-content: center;
    align-items: center;
    background-color: #3a4152;
  }
  .dott {
    font-size: 2.4;
    color: #06261f;
  }
  .col {
    flex-direction: column;
    gap: 0.5;
    width: 26;
  }
  .gtxt {
    font-size: 1.7;
    color: #eeeaff;
  }
  .bar {
    width: 17;
    height: 0.9;
    border-radius: 0.45;
    background-color: #3a4152;
  }
  .fill {
    width: 0.9;
    height: 0.9;
    border-radius: 0.45;
    background-color: #c8f560;
  }
  .num {
    font-size: 1.5;
    color: #a49fc8;
  }
  .line {
    flex-direction: row;
    align-items: center;
    gap: 1.2;
    width: 31;
  }
  .chest {
    width: 3.6;
    height: 2.8;
    border-radius: 0.8;
    background-color: #7a4318;
    border-width: 0.4;
    border-color: #ffd166;
  }
  .flame {
    width: 3;
    height: 3.6;
    border-radius: 1.5;
    background-color: #ff8a3d;
  }
  .ltxt {
    font-size: 1.7;
    color: #ffd166;
    width: 14;
  }
  .rtxt {
    font-size: 1.7;
    color: #ffb36b;
    width: 12;
  }
  .sh {
    width: 2.2;
    height: 2.8;
    border-radius: 1.1;
    background-color: #3a4152;
  }
  .badge {
    width: 4.4;
    height: 4.4;
    border-radius: 2.2;
    justify-content: center;
    align-items: center;
    background-color: #ffc94a;
    border-width: 0.4;
    border-color: #6e4508;
  }
  .badget {
    font-size: 2.6;
    color: #2a1600;
  }
  .ltitle {
    font-size: 1.8;
    color: #eeeaff;
  }
  .xpbar {
    width: 22;
    height: 0.9;
    border-radius: 0.45;
    background-color: #3a4152;
  }
  .xpfill {
    width: 0.9;
    height: 0.9;
    border-radius: 0.45;
    background-color: #c8f560;
  }
  .display {
    letter-spacing: 0.1;
  }
</style>
<div id="root" class="root">
  <span class="title display">HOY</span>
  <div id="g1" class="goal">
    <div id="g1-c" class="dot"><span id="g1-ct" class="dott"></span></div>
    <div class="col">
      <span id="g1-t" class="gtxt">Meta</span>
      <div class="bar"><div id="g1-f" class="fill"></div></div>
      <span id="g1-n" class="num">0 / 0</span>
    </div>
  </div>
  <div id="g2" class="goal">
    <div id="g2-c" class="dot"><span id="g2-ct" class="dott"></span></div>
    <div class="col">
      <span id="g2-t" class="gtxt">Meta</span>
      <div class="bar"><div id="g2-f" class="fill"></div></div>
      <span id="g2-n" class="num">0 / 0</span>
    </div>
  </div>
  <div id="g3" class="goal">
    <div id="g3-c" class="dot"><span id="g3-ct" class="dott"></span></div>
    <div class="col">
      <span id="g3-t" class="gtxt">Meta</span>
      <div class="bar"><div id="g3-f" class="fill"></div></div>
      <span id="g3-n" class="num">0 / 0</span>
    </div>
  </div>
  <div class="line">
    <div id="chest" class="chest"></div>
    <span id="chest-t" class="ltxt">Cofre: +100 XP, un escudo y un color</span>
  </div>
  <div class="line">
    <div class="flame"></div>
    <span id="streak-t" class="rtxt">Racha: 0 días</span>
    <div id="s0" class="sh"></div>
    <div id="s1" class="sh"></div>
    <div id="s2" class="sh"></div>
  </div>
  <div class="line">
    <div id="badge" class="badge"><span id="badge-t" class="badget display">1</span></div>
    <div class="col">
      <span id="lvl-t" class="ltitle">Nivel 1 · Novato</span>
      <div class="xpbar"><div id="xp-f" class="xpfill"></div></div>
      <span id="xp-n" class="num">0 / 100 XP</span>
    </div>
  </div>
</div>
