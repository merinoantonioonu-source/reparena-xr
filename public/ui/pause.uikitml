<!--
  La pausa (RepArena: pauseMenu), con el botón MENÚ de la muñeca (o X/Y del mando izquierdo) en plena ronda: cómo vas, las
  mejoras que llevas, los últimos avisos y Continuar, Recolocarme (volver a tomar la postura), Terminar ronda y Menú
  principal. Cuelga de su borde de arriba, como los menús. 56 cm de ancho.
-->
<style>
  .root {
    anchor-y: top;
    flex-direction: column;
    align-items: center;
    width: 56;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 3;
    padding-right: 3;
    gap: 1.4;
    background-color: #3a2d5c;
    border-radius: 3;
    border-width: 0.8;
    border-color: #ffd166;
  }
  .title {
    font-size: 6;
    color: #ffd166;
  }
  .line {
    font-size: 2.3;
    color: #eeeaff;
    text-align: center;
  }
  .btn {
    width: 48;
    height: 7;
    justify-content: center;
    align-items: center;
    border-radius: 3.5;
    background-color: #2a2f3a;
    cursor: pointer;
  }
  .btn:hover {
    background-color: #3a4150;
  }
  .go {
    background-color: #3cf0c6;
  }
  .go:hover {
    background-color: #8bffe6;
  }
  .bt {
    font-size: 3;
    color: #e9eef7;
  }
  .bt-go {
    color: #0d1016;
  }
</style>
<div class="root">
  <span class="title display">PAUSA</span>
  <span id="p-stats" class="line">12 repeticiones · 3 enemigos · 980 puntos</span>
  <span id="p-perks" class="line">Mejoras: Escudo</span>
  <span id="p-warn" class="line">Últimos avisos</span>
  <button id="p-go" class="btn go"><span class="bt bt-go display">CONTINUAR</span></button>
  <button id="p-recal" class="btn"><span class="bt display">RECOLOCARME</span></button>
  <button id="p-end" class="btn"><span class="bt display">TERMINAR RONDA</span></button>
  <button id="p-menu" class="btn"><span class="bt display">MENÚ PRINCIPAL</span></button>
  <button id="p-diag" class="btn"><span class="bt display">GUARDAR DIAGNÓSTICO</span></button>
</div>
