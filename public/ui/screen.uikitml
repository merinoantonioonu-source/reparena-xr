<!--
  Una pantalla genérica del menú (RepArena: openMenu(rows)): un título y hasta 12 filas, cada una de texto, de título grande o de
  botones (hasta cinco). La llenan la música (listas y canciones), pasar datos, la sincronización, el pulsómetro, la tabla del
  desarrollador y el teclado de números. 62 cm de ancho; cuelga de su borde de arriba, como los menús.
-->
<style>
  .root {
    anchor-y: top;
    flex-direction: column;
    align-items: center;
    width: 62;
    padding-top: 2.6;
    padding-bottom: 2.6;
    padding-left: 3;
    padding-right: 3;
    gap: 1.2;
    background-color: #1b1730;
    border-radius: 3;
    border-width: 0.8;
    border-color: #a68bff;
  }
  .title {
    font-size: 5;
    color: #a68bff;
  }
  .srow {
    flex-direction: column;
    align-items: center;
    width: 56;
    gap: 0.8;
  }
  .line {
    font-size: 2.3;
    color: #eeeaff;
    text-align: center;
    width: 56;
  }
  .skeys {
    flex-direction: row;
    justify-content: center;
    gap: 1.2;
    width: 56;
  }
  .sb {
    flex-grow: 1;
    flex-basis: 0;
    height: 6.4;
    justify-content: center;
    align-items: center;
    border-radius: 3.2;
    background-color: #2a2f3a;
    cursor: pointer;
  }
  .sb:hover {
    background-color: #3a4150;
  }
  .sbt {
    font-size: 2.4;
    color: #e9eef7;
  }
</style>
<div id="root" class="root">
  <span id="sc-title" class="title display">TÍTULO</span>
  <div id="r0" class="srow"><span id="r0t" class="line">.</span><div id="r0k" class="skeys"><button id="r0b0" class="sb"><span id="r0b0t" class="sbt display">·</span></button><button id="r0b1" class="sb"><span id="r0b1t" class="sbt display">·</span></button><button id="r0b2" class="sb"><span id="r0b2t" class="sbt display">·</span></button><button id="r0b3" class="sb"><span id="r0b3t" class="sbt display">·</span></button><button id="r0b4" class="sb"><span id="r0b4t" class="sbt display">·</span></button></div></div>
  <div id="r1" class="srow"><span id="r1t" class="line">.</span><div id="r1k" class="skeys"><button id="r1b0" class="sb"><span id="r1b0t" class="sbt display">·</span></button><button id="r1b1" class="sb"><span id="r1b1t" class="sbt display">·</span></button><button id="r1b2" class="sb"><span id="r1b2t" class="sbt display">·</span></button><button id="r1b3" class="sb"><span id="r1b3t" class="sbt display">·</span></button><button id="r1b4" class="sb"><span id="r1b4t" class="sbt display">·</span></button></div></div>
