<!--
  El botón MENÚ de la muñeca izquierda (RepArena: watch): sale al mirarte la muñeca (el dorso o la palma hacia la cara;
  con mando, levantado delante) y se pulsa con la otra mano. En la ronda, la pausa; fuera, trae el menú delante.
  9 × 4,2 cm.
-->
<style>
  .btn {
    width: 9;
    height: 4.2;
    justify-content: center;
    align-items: center;
    border-radius: 1.4;
    background-color: #ff4fa3;
    cursor: pointer;
  }
  .btn:hover {
    background-color: #ff8cc4;
  }
  .t {
    font-size: 1.6;
    color: #ffffff;
  }
</style>
<button id="w-btn" class="btn"><span id="w-t" class="t display">MENÚ</span></button>
