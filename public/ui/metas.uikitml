<!--
  La carátula «METAS DE HOY» (RepArena, src/73_career.js: drawHoy grande y goalsIntro): al entrar en las gafas, grande,
  a 2 m, con todo lo demás oscurecido: las tres metas con lo que llevas, lo que da el cofre y la racha con sus escudos.
  Se va sola a los 8 s o con cualquier botón, el pulgar arriba o una tecla, como la carátula del duelo. 130 cm de ancho
  (medidas en centímetros). La llena y la enseña src/ui/goals-intro.ts.
-->
<style>
  .root {
    flex-direction: column;
    align-items: center;
    width: 130;
    padding-top: 6;
    padding-bottom: 6;
    padding-left: 8;
    padding-right: 8;
    gap: 3.4;
    background-color: #1a1430;
    border-radius: 8;
    border-width: 1;
    border-color: #ff4fa3;
  }
  .title {
    font-size: 9;
    color: #ffd166;
  }
  .sub {
    font-size: 3.6;
    color: #a49fc8;
    text-align: center;
  }
  .goal {
    flex-direction: row;
    align-items: center;
    gap: 3;
    width: 110;
    height: 13;
  }
  .dot {
    width: 9;
    height: 9;
    border-radius: 4.5;
    justify-content: center;
    align-items: center;
    background-color: #3a4152;
  }
  .dott {
    font-size: 6;
    color: #06261f;
  }
  .col {
    flex-direction: column;
    gap: 1.4;
    width: 96;
  }
  .gtxt {
    font-size: 4.6;
    color: #eeeaff;
  }
  .bar {
    width: 80;
    height: 1.8;
    border-radius: 0.9;
    background-color: #3a4152;
  }
  .fill {
    width: 1.8;
    height: 1.8;
    border-radius: 0.9;
    background-color: #c8f560;
  }
  .num {
    font-size: 3.4;
    color: #a49fc8;
  }
  .line {
    flex-direction: row;
    align-items: center;
    gap: 3;
    width: 110;
  }
  .chest {
    width: 9;
    height: 7;
    border-radius: 2;
    background-color: #7a4318;
    border-width: 0.8;
    border-color: #ffd166;
  }
  .flame {
    width: 7.6;
    height: 9;
    border-radius: 3.8;
    background-color: #ff8a3d;
  }
  .ltxt {
    font-size: 4.4;
    color: #ffd166;
    width: 90;
  }
  .rtxt {
    font-size: 4.4;
    color: #ffb36b;
    width: 62;
  }
  .sh {
    width: 6;
    height: 7.4;
    border-radius: 3;
    background-color: #3a4152;
  }
  .foot {
    font-size: 3.4;
    color: #a49fc8;
  }
  .display {
    letter-spacing: 0.1;
  }
</style>
<div id="box" class="root">
  <span class="title display">METAS DE HOY</span>
  <span id="sub" class="sub">0 de 3</span>
  <div id="g1" class="goal">
    <div id="g1-c" class="dot"><span id="g1-ct" class="dott"></span></div>
    <div class="col">
      <span id="g1-t" class="gtxt">Meta</span>
      <div class="bar"><div id="g1-f" class="fill"></div></div>
      <span id="g1-n" class="num">0 / 0</span>
    </div>
  </div>
  <div id="g2" class="goal">
    <div id="g2-c" class="dot"><span id="g2-ct" class="dott"></span></div>
    <div class="col">
      <span id="g2-t" class="gtxt">Meta</span>
      <div class="bar"><div id="g2-f" class="fill"></div></div>
      <span id="g2-n" class="num">0 / 0</span>
    </div>
  </div>
  <div id="g3" class="goal">
    <div id="g3-c" class="dot"><span id="g3-ct" class="dott"></span></div>
    <div class="col">
      <span id="g3-t" class="gtxt">Meta</span>
      <div class="bar"><div id="g3-f" class="fill"></div></div>
      <span id="g3-n" class="num">0 / 0</span>
    </div>
  </div>
  <div class="line">
    <div id="chest" class="chest"></div>
    <span id="chest-t" class="ltxt">Cofre</span>
  </div>
  <div class="line">
    <div class="flame"></div>
    <span id="streak-t" class="rtxt">Racha</span>
    <div id="s0" class="sh"></div>
    <div id="s1" class="sh"></div>
    <div id="s2" class="sh"></div>
  </div>
  <span class="foot">Cualquier botón (o el pulgar arriba) para seguir</span>
</div>
